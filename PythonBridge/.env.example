# Reference only. The application does not automatically load this file.
# Configure these values in the Windows service or approved secret store.
APP_ENV=production
AUTH_MODE=trusted_proxy
AUTH_PROXY_SECRET=replace-with-a-high-entropy-secret

DB_AUTH_MODE=windows
DB_SERVER=sql-company.example.internal
DB_NAME=ExcelBridge
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_QUERY_TIMEOUT=30

# Excel client setting; normally deployed by Group Policy or an installer.
PYTHON_BRIDGE_URL=https://excelbridge.example.internal
